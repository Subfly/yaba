{
  "name": "yaba-web-components",
  "version": "1.0.0",
  "description": "WebView components for YABA: CodeMirror Markdown note editor, read-it-later (DOM), html-to-markdown.bundle (JSC), canvas, EPUB viewer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.html-to-markdown.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@excalidraw/excalidraw": "^0.18.0",
    "@mozilla/readability": "^0.6.0",
    "codemirror": "^6.0.2",
    "dompurify": "3.3.1",
    "epubjs": "^0.3.93",
    "linkedom": "^0.18.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rehype-format": "^5.0.1",
    "rehype-ignore": "^2.0.3",
    "rehype-parse": "^9.0.1",
    "rehype-prism-plus": "^2.0.2",
